@inject UserManager<ApplicationUser> UserManager
@inject IImageStorage ImageStorage
@inject ICartService CartService
@{
    @* El layout es la plantilla común: calcula navegación y datos de usuario una vez. *@
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var currentName = currentUser?.DisplayName ?? User.Identity?.Name ?? "Usuario";
    var currentInitial = string.IsNullOrWhiteSpace(currentName)
        ? "U"
        : currentName[..1].ToUpperInvariant();
    var cartCount = User.Identity?.IsAuthenticated == true ? CartService.GetTotalQuantity() : 0;
    var activeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAdminController = activeController is "Users" or "Authors" or "Categories" or "Books" or "Orders";
    var isAdminSection = isAdminController && User.IsInRole(RoleNames.Admin);
    string NavClass(string controller) => string.Equals(activeController, controller, StringComparison.OrdinalIgnoreCase)
        ? "nav-link active"
        : "nav-link";
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "Biblioteca Digital" : $"{ViewData["Title"]} · Biblioteca Digital")</title>
    @* Aplicamos el tema guardado antes de pintar para evitar un destello de color. *@
    <script>
        (() => {
            const savedTheme = localStorage.getItem("biblioteca-theme");
            const theme = savedTheme === "dark" || savedTheme === "light"
                ? savedTheme
                : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg app-navbar sticky-top">
        <div class="container-xl">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index" aria-label="Biblioteca Digital, inicio">
                <span class="brand-mark">B</span> Biblioteca
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                @* La navegación cambia según autenticación y rol, pero las vistas no repiten este código. *@
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class='@NavClass("Home")' asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class='@NavClass("Books")' asp-controller="Books" asp-action="Index">Libros</a></li>
                    <li class="nav-item"><a class='@NavClass("Authors")' asp-controller="Authors" asp-action="Index">Autores</a></li>
                    <li class="nav-item"><a class='@NavClass("Categories")' asp-controller="Categories" asp-action="Index">Categorías</a></li>
                    <li class="nav-item"><a class='@NavClass("Reviews")' asp-controller="Reviews" asp-action="Index">Reseñas</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class='@NavClass("Orders")' asp-controller="Orders" asp-action="Index">Pedidos</a></li>
                    }
                    @if (User.IsInRole(RoleNames.Admin))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isAdminSection ? "active" : null)" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Administración
                            </a>
                            <ul class="dropdown-menu">
                                <li><h6 class="dropdown-header">Gestionar catálogo</h6></li>
                                <li><a class="dropdown-item" asp-controller="Books" asp-action="Index">Libros</a></li>
                                <li><a class="dropdown-item" asp-controller="Authors" asp-action="Index">Autores</a></li>
                                <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">Categorías</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><h6 class="dropdown-header">Gestionar usuarios</h6></li>
                                <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Usuarios</a></li>
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">Pedidos</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <button class="btn btn-outline-secondary btn-sm theme-toggle" type="button"
                                data-theme-toggle aria-pressed="false" title="Cambiar a modo oscuro">
                            <i class="fa-solid fa-moon" data-theme-icon aria-hidden="true"></i>
                            <span class="d-none d-sm-inline" data-theme-label>Oscuro</span>
                            <span class="visually-hidden" data-theme-sr-label>Cambiar a modo oscuro</span>
                        </button>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link cart-link d-inline-flex align-items-center gap-2" asp-controller="Cart" asp-action="Index">
                                <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                                <span>Carrito</span>
                                @if (cartCount > 0)
                                {
                                    <span class="cart-count" aria-label="@cartCount artículo(s) en el carrito">@cartCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (currentUser?.AvatarFileName is string avatarFileName)
                                {
                                    <img class="avatar avatar-xs" src="@ImageStorage.GetUrl(ImageFolder.Avatars, avatarFileName)" alt="Avatar de @(currentUser.DisplayName ?? currentUser.UserName)" />
                                }
                                else
                                {
                                    <span class="avatar avatar-xs avatar-placeholder">@currentInitial</span>
                                }
                                <span class="d-lg-none d-xl-inline">@currentName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><h6 class="dropdown-header">Hola, @currentName</h6></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Mi perfil</a></li>
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index">Mis pedidos</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="dropdown-item text-danger" type="submit">Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                        <li class="nav-item mt-2 mt-lg-0"><a class="btn btn-primary btn-sm text-white" asp-controller="Account" asp-action="Register">Crear cuenta</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-xl app-main py-4 py-lg-5 flex-grow-1">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @* Cada vista concreta se inserta aquí mediante RenderBody. *@
        @RenderBody()
    </main>

    <footer class="container-xl py-4 mt-auto">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-4 border-top">
            <div>
                <p class="mb-1 fw-semibold">Biblioteca Digital</p>
                <p class="small mb-0">Proyecto de referencia · ASP.NET Core MVC · .NET 10 · EF Core</p>
            </div>
            <div class="d-flex flex-wrap gap-3 small">
                <a asp-controller="Books" asp-action="Index">Catálogo</a>
                <a asp-controller="Authors" asp-action="Index">Autores</a>
                <a asp-controller="Reviews" asp-action="Index">Reseñas</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
