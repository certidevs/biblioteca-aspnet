@inject UserManager<ApplicationUser> UserManager
@inject IImageStorage ImageStorage
@inject ICartService CartService
@{
    var currentUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var currentName = currentUser?.DisplayName ?? User.Identity?.Name ?? "Usuario";
    var currentInitial = string.IsNullOrWhiteSpace(currentName)
        ? "U"
        : currentName[..1].ToUpperInvariant();
    var cartCount = User.Identity?.IsAuthenticated == true ? CartService.GetTotalQuantity() : 0;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "Biblioteca Digital" : $"{ViewData["Title"]} · Biblioteca Digital")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">B</span> Biblioteca
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mostrar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Libros</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Authors" asp-action="Index">Autores</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Categorías</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Reviews" asp-action="Index">Reseñas</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Orders" asp-action="Index">Pedidos</a></li>
                    }
                    @if (User.IsInRole(RoleNames.Admin))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Usuarios</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link cart-link" asp-controller="Cart" asp-action="Index">
                                <span aria-hidden="true">🛒</span> Carrito
                                @if (cartCount > 0)
                                {
                                    <span class="badge rounded-pill text-bg-light text-primary">@cartCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" asp-controller="Profile" asp-action="Index">
                                @if (currentUser?.AvatarFileName is string avatarFileName)
                                {
                                    <img class="avatar avatar-xs" src="@ImageStorage.GetUrl(ImageFolder.Avatars, avatarFileName)" alt="Avatar de @(currentUser.DisplayName ?? currentUser.UserName)" />
                                }
                                else
                                {
                                    <span class="avatar avatar-xs avatar-placeholder">@currentInitial</span>
                                }
                                <span>Mi perfil</span>
                            </a>
                        </li>
                        <li class="nav-item"><span class="navbar-text small">Hola, @currentName</span></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-light" type="submit">Cerrar sesión</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                        <li class="nav-item"><a class="btn btn-sm btn-light text-primary" asp-controller="Account" asp-action="Register">Registrarse</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="container py-4 mt-auto">
        <hr />
        <p class="text-muted small mb-0">Biblioteca Digital · ASP.NET Core MVC · .NET 10 · EF Core · Bootstrap</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
