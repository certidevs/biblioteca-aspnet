@model Book
@{
    ViewData["Title"] = "Eliminar libro";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-panel">
            <span class="eyebrow text-danger">Administración</span>
            <h1 class="h2 mt-1">Eliminar libro</h1>
            <p>¿Seguro que quieres eliminar <strong>@Model.Title</strong>?</p>
            <p class="text-secondary small">También se eliminarán sus reseñas, compras y relaciones de catálogo por las reglas de cascada configuradas en EF Core.</p>
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="d-flex gap-2">
                    <button class="btn btn-danger" type="submit">Sí, eliminar</button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
