@model BookListViewModel
@inject IImageStorage ImageStorage
@{
    ViewData["Title"] = "Libros";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">Catálogo</span>
        <h1 class="h2 mt-1 mb-1">Libros</h1>
        <p class="text-secondary mb-0">Busca por título, autor o categoría y abre la ficha de cada libro.</p>
    </div>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <a class="btn btn-primary" asp-action="Create">+ Nuevo libro</a>
    }
</div>

<form class="form-panel mb-4" method="get">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label class="form-label" for="search">Texto</label>
            <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Título o autor" />
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label" for="authorId">Autor</label>
            <select class="form-select" id="authorId" name="authorId">
                <option value="">Todos</option>
                @foreach (var author in Model.Authors)
                {
                    if (Model.AuthorId == author.Id)
                    {
                        <option value="@author.Id" selected>@author.Name</option>
                    }
                    else
                    {
                        <option value="@author.Id">@author.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label" for="categoryId">Categoría</label>
            <select class="form-select" id="categoryId" name="categoryId">
                <option value="">Todas</option>
                @foreach (var category in Model.Categories)
                {
                    if (Model.CategoryId == category.Id)
                    {
                        <option value="@category.Id" selected>@category.Name</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4 col-lg-2">
            <label class="form-label" for="available">Disponibilidad</label>
            <select class="form-select" id="available" name="available">
                <option value="">Todos</option>
                @if (Model.Available == true)
                {
                    <option value="true" selected>Disponibles</option>
                }
                else
                {
                    <option value="true">Disponibles</option>
                }
                @if (Model.Available == false)
                {
                    <option value="false" selected>No disponibles</option>
                }
                else
                {
                    <option value="false">No disponibles</option>
                }
            </select>
        </div>
        <div class="col-lg-2 d-grid">
            <button class="btn btn-primary" type="submit">Filtrar</button>
        </div>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="favoritesOnly" name="favoritesOnly" value="true" @(Model.FavoritesOnly ? "checked" : null) />
            <label class="form-check-label" for="favoritesOnly">Mostrar solo mis favoritos</label>
        </div>
    }
</form>

@if (Model.Books.Count == 0)
{
    <div class="empty-state text-center">
        <h2 class="h4">No hay libros que coincidan</h2>
        <p class="text-secondary">Prueba a quitar algún filtro o vuelve al catálogo completo.</p>
        <a class="btn btn-outline-primary" asp-action="Index">Limpiar filtros</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var book in Model.Books)
        {
            var isFavorite = Model.CurrentUserId is not null && book.FavoriteUsers.Any(user => user.Id == Model.CurrentUserId);
            <div class="col-md-6 col-xl-4">
                <article class="book-card h-100">
                    <div class="book-cover">
                        @if (ImageStorage.GetUrl(ImageFolder.BookCovers, book.CoverImageFileName) is string coverUrl)
                        {
                            <img src="@coverUrl" alt="Portada de @book.Title" />
                        }
                        else
                        {
                            <span aria-hidden="true">📖</span>
                        }
                    </div>
                    <div class="p-3 d-flex flex-column h-100">
                        <div class="d-flex justify-content-between gap-2 align-items-start">
                            <h2 class="h5 mb-1"><a class="link-dark text-decoration-none" asp-action="Details" asp-route-id="@book.Id">@book.Title</a></h2>
                            @if (isFavorite)
                            {
                                <span title="Favorito" aria-label="Favorito">⭐</span>
                            }
                        </div>
                        <p class="text-secondary small mb-2">@book.Author.Name</p>
                        <div class="mb-3">
                            @foreach (var category in book.Categories)
                            {
                                <span class="badge-soft me-1 mb-1" style="background-color:@ColorContrast.NormalizeHex(category.Color); color:@ColorContrast.TextColor(category.Color)">@category.Name</span>
                            }
                        </div>
                        <p class="small text-secondary flex-grow-1">@book.Synopsis</p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="price-tag">@book.Price.ToString("C")</span>
                            <span class="badge @(book.Available ? "text-bg-success" : "text-bg-secondary")">@(book.Available ? "Disponible" : "No disponible")</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@book.Id">Ver detalle</a>
                            @if (User.Identity?.IsAuthenticated == true && book.Available)
                            {
                                <form asp-action="AddToCart" method="post" class="flex-grow-1">
                                    <input type="hidden" name="id" value="@book.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button class="btn btn-sm btn-primary w-100" type="submit"><span aria-hidden="true">🛒</span> Añadir</button>
                                </form>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-action="ToggleFavorite" method="post">
                                    <input type="hidden" name="id" value="@book.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button class="btn btn-sm btn-outline-warning" type="submit" title="@(isFavorite ? "Quitar de favoritos" : "Añadir a favoritos")">@(isFavorite ? "★" : "☆")</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
