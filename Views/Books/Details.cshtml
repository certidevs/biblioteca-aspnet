@model Book
@inject ImageStorage ImageStorage
@{
    ViewData["Title"] = Model.Title;
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var isFavorite = User.Identity?.IsAuthenticated == true && Model.FavoriteUsers.Any(user => user.UserName == User.Identity!.Name);
}

<header class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <a class="small text-decoration-none" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Volver al catálogo</a>
        <span class="eyebrow d-block mt-4">Ficha del libro</span>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle mb-0">por <a asp-controller="Authors" asp-action="Details" asp-route-id="@Model.AuthorId">@Model.Author.Name</a></p>
    </div>
    <span class="badge rounded-pill @(Model.Available ? "text-bg-success" : "text-bg-secondary") mt-4">@(Model.Available ? "Disponible" : "No disponible")</span>
</header>

<div class="row g-4">
    <div class="col-lg-8">
        <section class="detail-panel h-100">
            <div class="row g-4 g-xl-5">
                <div class="col-sm-4 col-lg-5 col-xl-4">
                    <div class="book-cover rounded-4">
                        @if (ImageStorage.GetUrl(ImageFolder.BookCovers, Model.CoverImageFileName) is string coverUrl)
                        {
                            <img src="@coverUrl" alt="Portada de @Model.Title" />
                        }
                        else
                        {
                            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                        }
                    </div>
                    <div class="d-flex justify-content-between align-items-center gap-2 mt-3">
                        <span class="price-tag fs-4">@Model.Price.ToString("C")</span>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-action="ToggleFavorite" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button class="btn btn-sm btn-outline-warning" type="submit" title="@(isFavorite ? "Quitar de favoritos" : "Añadir a favoritos")" aria-label="@(isFavorite ? "Quitar de favoritos" : "Añadir a favoritos")">
                                    <i class="@(isFavorite ? "fa-solid" : "fa-regular") fa-heart" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
                <div class="col-sm-8 col-lg-7 col-xl-8">
                    <span class="eyebrow">Sobre esta lectura</span>
                    <h2 class="h3 mt-2">Sinopsis</h2>
                    <p class="text-secondary">@(string.IsNullOrWhiteSpace(Model.Synopsis) ? "Este libro todavía no tiene sinopsis." : Model.Synopsis)</p>

                    <dl class="row book-meta mt-4 mb-0">
                        <dt class="col-5">ISBN</dt>
                        <dd class="col-7">@(Model.Isbn ?? "—")</dd>
                        <dt class="col-5">Páginas</dt>
                        <dd class="col-7">@(Model.Pages?.ToString() ?? "—")</dd>
                        <dt class="col-5">Idioma</dt>
                        <dd class="col-7">@(Model.Language ?? "—")</dd>
                        <dt class="col-5">Publicación</dt>
                        <dd class="col-7">@(Model.PublishDate?.ToString("dd/MM/yyyy") ?? "—")</dd>
                    </dl>

                    @if (User.Identity?.IsAuthenticated == true && Model.Available)
                    {
                        <form asp-action="AddToCart" method="post" class="mt-4 pt-3 border-top">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <div class="d-flex flex-wrap align-items-end gap-2">
                                <div>
                                    <label class="form-label small mb-1" for="quantity">Cantidad</label>
                                    <input class="form-control form-control-sm" id="quantity" name="quantity" type="number" min="1" max="99" value="1" style="width: 6rem" />
                                </div>
                        <button class="btn btn-primary" type="submit"><i class="fa-solid fa-cart-shopping me-1" aria-hidden="true"></i>Añadir al carrito</button>
                            </div>
                        </form>
                    }
                    else if (User.Identity?.IsAuthenticated != true && Model.Available)
                    {
                        <a class="btn btn-primary mt-4" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@currentUrl">Inicia sesión para comprar</a>
                    }
                    @if (User.IsInRole(RoleNames.Admin))
                    {
                        <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar libro</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a>
                        </div>
                    }
                </div>
            </div>
        </section>
    </div>
    <div class="col-lg-4">
        <section class="detail-panel h-100 profile-summary">
            <span class="eyebrow">Clasificación</span>
            <h2 class="h4 mt-2">Categorías</h2>
            <div class="d-flex flex-wrap gap-2 mb-5">
                @foreach (var category in Model.Categories)
                {
                    <a class="badge-soft text-decoration-none" style="background-color:@ColorContrast.NormalizeHex(category.Color); color:@ColorContrast.TextColor(category.Color)" asp-controller="Categories" asp-action="Details" asp-route-id="@category.Id">@category.Name</a>
                }
            </div>
            <span class="eyebrow">El autor</span>
            <div class="d-flex align-items-start gap-3 mt-2">
                @if (ImageStorage.GetUrl(ImageFolder.AuthorPhotos, Model.Author.PhotoFileName) is string authorPhotoUrl)
                {
                    <img class="author-photo author-photo-inline" src="@authorPhotoUrl" alt="Fotografía de @Model.Author.Name" />
                }
                else
                {
                    <div class="author-photo author-photo-inline" aria-hidden="true">
                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                    </div>
                }
                <div>
                    <h2 class="h4 mb-1">@Model.Author.Name</h2>
                    <p class="small text-secondary mb-0">@(Model.Author.Bio ?? "Sin biografía disponible.")</p>
                </div>
            </div>
            <a class="btn btn-sm btn-outline-primary mt-3" asp-controller="Authors" asp-action="Details" asp-route-id="@Model.AuthorId">Ver autor <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a>
        </section>
    </div>
</div>

<section class="mt-5">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
        <div>
            <span class="eyebrow">Opiniones</span>
            <h2 class="h3 mt-2 mb-0">Reseñas <span class="text-secondary">(@Model.Reviews.Count)</span></h2>
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Reviews" asp-action="Create" asp-route-bookId="@Model.Id">Escribir reseña</a>
        }
    </div>

    @if (Model.Reviews.Count == 0)
    {
        <div class="empty-state text-center py-5">
            <p class="text-secondary mb-0">Todavía no hay reseñas para este libro.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var review in Model.Reviews.OrderByDescending(review => review.CreatedAt))
            {
                <div class="col-md-6">
                    <article class="detail-panel h-100">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>@(review.User.DisplayName ?? review.User.UserName)</strong>
                            <span class="rating" title="@review.Rating de 5" aria-label="@review.Rating de 5 estrellas">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <i class="@(star <= review.Rating ? "fa-solid" : "fa-regular") fa-star" aria-hidden="true"></i>
                                }
                            </span>
                        </div>
                        <p class="small text-secondary mt-2">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                        <p class="mb-0">@review.Comment</p>
                        @if (User.IsInRole(RoleNames.Admin) || review.User.UserName == User.Identity?.Name)
                        {
                            <div class="mt-3 d-flex gap-2">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Reviews" asp-action="Edit" asp-route-id="@review.Id">Editar</a>
                                <form asp-controller="Reviews" asp-action="Delete" method="post">
                                    <input type="hidden" name="id" value="@review.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                </form>
                            </div>
                        }
                    </article>
                </div>
            }
        </div>
    }
</section>
