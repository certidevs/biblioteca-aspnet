@model BookFormViewModel
@{
    ViewData["Title"] = "Editar libro";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="form-panel">
            <span class="eyebrow">Administración</span>
            <h1 class="page-title">Editar libro</h1>
            <p class="page-subtitle">Actualiza la información editorial, la portada y las categorías del libro.</p>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                <input asp-for="Id" type="hidden" />
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary" type="submit">Guardar cambios</button>
                    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
