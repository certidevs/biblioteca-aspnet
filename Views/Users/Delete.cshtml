@model ProfileViewModel
@{
    ViewData["Title"] = "Eliminar usuario";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-panel border-danger-subtle">
            <span class="eyebrow text-danger">Administración</span>
            <h1 class="page-title">Eliminar usuario</h1>
            <p>Vas a eliminar la cuenta <strong>@(Model.User.DisplayName ?? Model.User.UserName)</strong>.</p>
            <div class="alert alert-warning">También se eliminarán sus favoritos, reseñas y compras asociadas por las relaciones configuradas en el modelo.</div>
            <form asp-action="Delete" asp-route-id="@Model.User.Id" method="post">
                <div class="d-flex gap-2"><button class="btn btn-danger" type="submit">Sí, eliminar cuenta</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.User.Id">Cancelar</a></div>
            </form>
        </div>
    </div>
</div>
