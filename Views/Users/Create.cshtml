@model CreateUserViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="form-panel">
            <a class="small text-decoration-none" asp-action="Index">← Volver a usuarios</a>
            <span class="eyebrow d-block mt-3">Administración</span>
            <h1 class="h2 mt-1">Nuevo usuario</h1>
            <p class="text-secondary">Crea una cuenta desde el panel de administración. La contraseña se guarda cifrada mediante Identity.</p>
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autofocus /><span asp-validation-for="Username" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" /><span asp-validation-for="DisplayName" class="text-danger"></span></div>
                    <div class="col-md-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option value="User">Usuario</option><option value="Admin">Administrador</option></select></div>
                    <div class="col-md-3 d-flex align-items-center pt-md-4"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
                    <div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="PasswordConfirmation" class="form-label"></label><input asp-for="PasswordConfirmation" class="form-control" /><span asp-validation-for="PasswordConfirmation" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="Avatar" class="form-label"></label><input asp-for="Avatar" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" /><div class="form-text">Opcional. JPG, PNG, GIF o WEBP; máximo 5 MB.</div><span asp-validation-for="Avatar" class="text-danger"></span></div>
                </div>
                <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Crear usuario</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
