@model ProfileViewModel
@inject IImageStorage ImageStorage
@{
    ViewData["Title"] = "Detalle de usuario";
    var name = Model.User.DisplayName ?? Model.User.UserName ?? "Usuario";
    var initial = string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        @if (ImageStorage.GetUrl(ImageFolder.Avatars, Model.User.AvatarFileName) is string avatarUrl)
        {
            <img class="avatar avatar-xl" src="@avatarUrl" alt="Avatar de @name" />
        }
        else
        {
            <span class="avatar avatar-xl avatar-placeholder">@initial</span>
        }
        <div><a class="small text-decoration-none" asp-action="Index">← Volver a usuarios</a><h1 class="h2 mt-2 mb-1">@name</h1><p class="text-secondary mb-0">@Model.User.Email</p></div>
    </div>
    <div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.User.Id">Editar usuario</a><a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.User.Id">Eliminar</a></div>
</div>

<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Favoritos</span><strong class="stat-number">@Model.FavoriteBooks.Count</strong></div></div><div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Reseñas</span><strong class="stat-number">@Model.Reviews.Count</strong></div></div><div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Pedidos</span><strong class="stat-number">@Model.Orders.Count</strong></div></div><div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Gastado</span><strong class="stat-number fs-3">@Model.TotalSpent.ToString("C")</strong></div></div></div>

<section class="detail-panel"><h2 class="h4">Actividad reciente</h2>@if (Model.Orders.Count == 0 && Model.Reviews.Count == 0) { <p class="text-secondary mb-0 mt-3">No hay actividad registrada.</p> } else { <ul class="list-group list-group-flush mt-3">@foreach (var order in Model.Orders.Take(5)) { <li class="list-group-item px-0"><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Pedido #@order.Id</a> por <strong>@order.Total.ToString("C")</strong></li> } @foreach (var review in Model.Reviews.Take(5)) { <li class="list-group-item px-0">Reseña de <strong>@review.Book.Title</strong>: @review.Rating/5</li> }</ul> }</section>
