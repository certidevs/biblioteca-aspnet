@model List<UserListItemViewModel>
@inject ImageStorage ImageStorage
@{
    ViewData["Title"] = "Usuarios";
    var search = ViewData["Search"] as string;
}

<header class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <span class="eyebrow">Administración</span>
        <h1 class="page-title">Usuarios</h1>
        <p class="page-subtitle mb-0">Gestiona cuentas, roles, contraseñas, avatares y estado de activación.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge-soft">@Model.Count cuenta(s)</span>
        <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Nuevo usuario</a>
    </div>
</header>

<form class="search-panel p-3 p-lg-4 mb-4" method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-9">
            <label class="form-label" for="search">Buscar una cuenta</label>
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input class="form-control" id="search" name="search" value="@search" placeholder="Usuario, email o nombre" />
            </div>
        </div>
        <div class="col-md-3 d-grid">
            <button class="btn btn-primary" type="submit">Buscar usuarios</button>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state text-center">
        <div class="empty-icon mx-auto" aria-hidden="true">&#64;</div>
        <h2 class="h4 mt-3">No hay usuarios que coincidan</h2>
        <p class="text-secondary mb-0">Prueba con otro nombre, usuario o email.</p>
    </div>
}
else
{
    <section class="table-panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var name = item.User.DisplayName ?? item.User.UserName ?? "Usuario";
                        var initial = string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (ImageStorage.GetUrl(ImageFolder.Avatars, item.User.AvatarFileName) is string avatarUrl)
                                    {
                                        <img class="avatar avatar-sm" src="@avatarUrl" alt="Avatar de @name" />
                                    }
                                    else
                                    {
                                        <span class="avatar avatar-sm avatar-placeholder">@initial</span>
                                    }
                                    <div><strong>@name</strong><div class="small text-secondary">@($"@{item.User.UserName}")</div></div>
                                </div>
                            </td>
                            <td>@item.User.Email</td>
                            <td><span class="badge-soft">@item.Role</span></td>
                            <td><span class="badge rounded-pill @(item.User.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.User.IsActive ? "Activa" : "Inactiva")</span></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.User.Id">Ver</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.User.Id">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
