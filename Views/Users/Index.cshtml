@model List<UserListItemViewModel>
@inject IImageStorage ImageStorage
@{
    ViewData["Title"] = "Usuarios";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-end gap-3 mb-4">
    <div><span class="eyebrow">Administración</span><h1 class="h2 mt-1 mb-1">Usuarios</h1><p class="text-secondary mb-0">Gestiona cuentas, roles, contraseñas, avatares y estado de activación.</p></div>
    <a class="btn btn-primary" asp-action="Create">+ Nuevo usuario</a>
</div>

<form class="form-panel mb-4" method="get">
    <div class="row g-2 align-items-end"><div class="col-md-10"><label class="form-label" for="search">Buscar</label><input class="form-control" id="search" name="search" value="@search" placeholder="Usuario, email o nombre" /></div><div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Buscar</button></div></div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state text-center"><p class="text-secondary mb-0">No hay usuarios que coincidan.</p></div>
}
else
{
    <div class="table-panel"><table class="table align-middle mb-0"><thead><tr><th>Usuario</th><th>Email</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody>
        @foreach (var item in Model)
        {
            var name = item.User.DisplayName ?? item.User.UserName ?? "Usuario";
            var initial = string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();
            <tr>
                <td><div class="d-flex align-items-center gap-2">@if (ImageStorage.GetUrl(ImageFolder.Avatars, item.User.AvatarFileName) is string avatarUrl) { <img class="avatar avatar-sm" src="@avatarUrl" alt="Avatar de @name" /> } else { <span class="avatar avatar-sm avatar-placeholder">@initial</span> }<div><strong>@name</strong><div class="small text-secondary">@item.User.UserName</div></div></div></td>
                <td>@item.User.Email</td>
                <td><span class="badge-soft">@item.Role</span></td>
                <td><span class="badge @(item.User.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.User.IsActive ? "Activa" : "Inactiva")</span></td>
                <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.User.Id">Ver</a> <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.User.Id">Editar</a></td>
            </tr>
        }
    </tbody></table></div>
}
