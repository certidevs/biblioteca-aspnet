@model DashboardViewModel
@inject IImageStorage ImageStorage
@{
    ViewData["Title"] = "Inicio";
}

<section class="bg-primary text-white rounded-4 p-4 p-lg-5 mb-5 shadow-sm">
    <div class="row align-items-center g-4 g-xl-5">
        <div class="col-lg-8">
            <span class="badge text-bg-light text-primary">Proyecto de referencia</span>
            <h1 class="display-4 fw-bold mt-3 mb-3">Una buena historia empieza aquí.</h1>
            <p class="lead mb-3">Explora una biblioteca digital construida para aprender ASP.NET Core MVC, C#, EF Core, Identity y Razor.</p>
            <p class="mb-0 text-white-50">Un proyecto pequeño, completo y fácil de ampliar: catálogo, usuarios, reseñas, favoritos y un checkout ficticio.</p>
            <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
                <a class="btn btn-light text-primary" asp-controller="Books" asp-action="Index">Explorar catálogo <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i></a>
                <a class="btn btn-link link-light text-decoration-none px-0" asp-controller="Reviews" asp-action="Index">Leer reseñas <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a>
            </div>
            <div class="d-flex flex-wrap gap-3 mt-4 small text-white-50">
                <span><i class="fa-solid fa-database me-1" aria-hidden="true"></i>Datos de demostración</span>
                <span><i class="fa-solid fa-mobile-screen-button me-1" aria-hidden="true"></i>Responsive</span>
                <span><i class="fa-brands fa-bootstrap me-1" aria-hidden="true"></i>Bootstrap 5</span>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="bg-white bg-opacity-10 rounded-4 p-4 text-center">
                <i class="fa-solid fa-book-open display-1 mb-3" aria-hidden="true"></i>
                <h2 class="h4">Historias que dejan huella</h2>
                <p class="mb-0 text-white-50">Lee, descubre y comparte tus próximas lecturas.</p>
            </div>
        </div>
    </div>
</section>

<section class="row g-3 mb-5" aria-label="Resumen del catálogo">
    <div class="col-md-4">
        <article class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Libros</span>
                <span class="badge-soft">01</span>
            </div>
            <strong class="stat-number">@Model.BookCount</strong>
            <p class="text-secondary mb-0">Catálogo con detalle, disponibilidad, compra y favoritos.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Autores</span>
                <span class="badge-soft">02</span>
            </div>
            <strong class="stat-number">@Model.AuthorCount</strong>
            <p class="text-secondary mb-0">Fichas de autor con sus obras relacionadas.</p>
        </article>
    </div>
    <div class="col-md-4">
        <article class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <span class="stat-label">Categorías</span>
                <span class="badge-soft">03</span>
            </div>
            <strong class="stat-number">@Model.CategoryCount</strong>
            <p class="text-secondary mb-0">Organización del catálogo mediante una relación N:M.</p>
        </article>
    </div>
</section>

<section class="section-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
    <div>
        <span class="eyebrow">Selección de la biblioteca</span>
        <h2 class="h2 mt-2 mb-1">Para empezar a leer</h2>
        <p class="text-secondary mb-0">Algunas historias disponibles en el catálogo.</p>
    </div>
    <a class="btn btn-sm btn-outline-primary" asp-controller="Books" asp-action="Index">Ver todos <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i></a>
</section>

@if (Model.FeaturedBooks.Count == 0)
{
    <div class="empty-state text-center">
        <p class="text-secondary mb-0">Todavía no hay libros destacados.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model.FeaturedBooks)
        {
            <div class="col-md-4">
                <article class="book-card h-100">
                    <div class="book-cover">
                        @if (ImageStorage.GetUrl(ImageFolder.BookCovers, book.CoverImageFileName) is string coverUrl)
                        {
                            <img src="@coverUrl" alt="Portada de @book.Title" />
                        }
                        else
                        {
                            <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                        }
                    </div>
                    <div class="p-3 p-lg-4 d-flex flex-column h-100">
                        <span class="small text-uppercase fw-bold text-secondary mb-2">Lectura recomendada</span>
                            <h3 class="h5 mb-1"><a class="link-body-emphasis text-decoration-none" asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a></h3>
                        <p class="text-secondary small mb-3">@book.Author.Name</p>
                        <p class="small text-secondary mb-4">@book.Synopsis</p>
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <span class="price-tag">@book.Price.ToString("C")</span>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">Descubrir <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
