@model ProfileEditViewModel
@inject IImageStorage ImageStorage
@{
    ViewData["Title"] = "Editar perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-panel">
            <a class="small text-decoration-none" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Volver a mi perfil</a>
            <span class="eyebrow d-block mt-3">Cuenta</span>
            <h1 class="page-title">Editar perfil</h1>
            <p class="page-subtitle">Actualiza tu nombre visible, email y avatar.</p>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label"></label>
                            <input asp-for="DisplayName" class="form-control" autofocus />
                            <span asp-validation-for="DisplayName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-5 upload-field">
                        @if (ImageStorage.GetUrl(ImageFolder.Avatars, Model.CurrentAvatarFileName) is string avatarUrl)
                        {
                            <img class="avatar avatar-xl mb-3" src="@avatarUrl" alt="Avatar actual" />
                        }
                        <label asp-for="Avatar" class="form-label"></label>
                        <input asp-for="Avatar" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" />
                        <div class="form-text">JPG, PNG, GIF o WEBP. Tamaño máximo: 5 MB.</div>
                        <span asp-validation-for="Avatar" class="text-danger"></span>
                        @if (Model.CurrentAvatarFileName is not null)
                        {
                            <div class="form-check mt-3">
                                <input asp-for="RemoveAvatar" class="form-check-input" />
                                <label asp-for="RemoveAvatar" class="form-check-label"></label>
                            </div>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary" type="submit">Guardar cambios</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
