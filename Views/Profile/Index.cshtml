@model ProfileViewModel
@inject ImageStorage ImageStorage
@{
    ViewData["Title"] = "Mi perfil";
    var profileName = Model.User.DisplayName ?? Model.User.UserName ?? "Usuario";
    var profileInitial = string.IsNullOrWhiteSpace(profileName)
        ? "U"
        : profileName[..1].ToUpperInvariant();
}

<header class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <span class="eyebrow">Cuenta</span>
        <h1 class="page-title">Mi perfil</h1>
        <p class="page-subtitle mb-0">Tu actividad, tus preferencias y tu recorrido por la biblioteca.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit">Editar perfil</a>
        <a class="btn btn-outline-secondary" asp-action="ChangePassword">Cambiar contraseña</a>
    </div>
</header>

<section class="detail-panel profile-summary mb-4">
    <div class="d-flex flex-wrap align-items-center gap-3">
        @if (ImageStorage.GetUrl(ImageFolder.Avatars, Model.User.AvatarFileName) is string avatarUrl)
        {
            <img class="avatar avatar-xl" src="@avatarUrl" alt="Avatar de @profileName" />
        }
        else
        {
            <span class="avatar avatar-xl avatar-placeholder">@profileInitial</span>
        }
        <div>
            <span class="eyebrow">Tu espacio lector</span>
            <h2 class="h3 mt-2 mb-1">Hola, @profileName</h2>
            <p class="text-secondary mb-0">@Model.User.Email · miembro desde @Model.User.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
        </div>
    </div>
</section>

<div class="row g-3 mb-5">
    <div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Favoritos</span><strong class="stat-number">@Model.FavoriteBooks.Count</strong><p class="small text-secondary mb-0">Libros guardados</p></div></div>
    <div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Reseñas</span><strong class="stat-number">@Model.Reviews.Count</strong><p class="small text-secondary mb-0">Opiniones compartidas</p></div></div>
    <div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Pedidos</span><strong class="stat-number">@Model.Orders.Count</strong><p class="small text-secondary mb-0">Compras realizadas</p></div></div>
    <div class="col-md-3"><div class="stat-card h-100"><span class="stat-label">Gastado</span><strong class="stat-number fs-3">@Model.TotalSpent.ToString("C")</strong><p class="small text-secondary mb-0">Total acumulado</p></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <section class="detail-panel h-100">
            <span class="eyebrow">Tu biblioteca</span>
            <h2 class="h3 mt-2">Mis favoritos</h2>
            @if (Model.FavoriteBooks.Count == 0)
            {
                <p class="text-secondary mt-3 mb-0">Todavía no tienes favoritos. <a asp-controller="Books" asp-action="Index">Explora el catálogo</a>.</p>
            }
            else
            {
                <ul class="list-group list-group-flush mt-3">
                    @foreach (var book in Model.FavoriteBooks)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-3"><a class="text-decoration-none" asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a><span class="price-tag text-nowrap">@book.Price.ToString("C")</span></li>
                    }
                </ul>
            }
        </section>
    </div>
    <div class="col-lg-6">
        <section class="detail-panel h-100">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <div><span class="eyebrow">Historial</span><h2 class="h3 mt-2 mb-0">Mis pedidos</h2></div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Orders" asp-action="Index">Ver todos</a>
            </div>
            @if (Model.Orders.Count == 0)
            {
                <p class="text-secondary mt-3 mb-0">Todavía no tienes pedidos.</p>
            }
            else
            {
                <div class="table-responsive mt-3">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Pedido</th><th>Fecha</th><th>Estado</th><th>Total</th></tr></thead>
                        <tbody>
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td><a class="text-decoration-none" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a><div class="small text-secondary">@string.Join(", ", order.Items.Select(item => $"{item.BookTitle} × {item.Quantity}"))</div></td>
                                    <td>@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge rounded-pill @(order.Status == OrderStatus.Paid ? "text-bg-success" : "text-bg-secondary")">@(order.Status == OrderStatus.Paid ? "Pagado" : order.Status.ToString())</span></td>
                                    <td class="text-nowrap">@order.Total.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
    <div class="col-lg-12">
        <section class="detail-panel">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <div><span class="eyebrow">Comunidad</span><h2 class="h3 mt-2 mb-0">Mis reseñas</h2></div>
                <a class="btn btn-sm btn-outline-primary" asp-controller="Reviews" asp-action="Index">Ver comunidad</a>
            </div>
            @if (Model.Reviews.Count == 0)
            {
                <p class="text-secondary mt-3 mb-0">Todavía no has escrito reseñas.</p>
            }
            else
            {
                <div class="row g-3 mt-1">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="col-md-6">
                            <article class="border rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between gap-2"><a class="fw-semibold text-decoration-none" asp-controller="Books" asp-action="Details" asp-route-id="@review.BookId">@review.Book.Title</a><span class="rating" title="@review.Rating de 5" aria-label="@review.Rating de 5 estrellas"><i class="fa-solid fa-star" aria-hidden="true"></i> @review.Rating</span></div>
                                <p class="small text-secondary mt-2 mb-0">@review.Comment</p>
                            </article>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
</div>
