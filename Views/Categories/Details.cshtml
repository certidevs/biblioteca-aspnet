@model Category
@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><a class="small text-decoration-none" asp-action="Index">← Volver a categorías</a><h1 class="h2 mt-2 mb-1">@Model.Name</h1><p class="text-secondary mb-0">@(Model.Description ?? "Sin descripción disponible.")</p></div>@if (User.IsInRole(RoleNames.Admin)) { <div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a><a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a></div>}</div>

<section><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h3 mb-0">Libros en esta categoría</h2><span class="badge-soft">@Model.Books.Count libro(s)</span></div><div class="row g-3">
@foreach (var book in Model.Books.OrderBy(book => book.Title))
{
    <div class="col-md-6 col-xl-4"><article class="book-card h-100"><div class="book-cover">📖</div><div class="p-3"><h3 class="h5"><a class="link-dark text-decoration-none" asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a></h3><p class="small text-secondary">@book.Author.Name</p><p class="price-tag mb-0">@book.Price.ToString("C")</p></div></article></div>
}
</div></section>
