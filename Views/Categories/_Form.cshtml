@model CategoryFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<section class="form-section">
    <span class="eyebrow">Etiqueta del catálogo</span>
    <h2 class="form-section-title">Información de la categoría</h2>
    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Color" class="form-label"></label>
            <input asp-for="Color" class="form-control" placeholder="#5757d6" />
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Explica qué tipo de libros agrupa."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>
</section>
