@model CategoryFormViewModel
@{
    ViewData["Title"] = "Editar categoría";
}

<div class="row justify-content-center"><div class="col-xl-8"><div class="form-panel"><span class="eyebrow">Administración</span><h1 class="h2 mt-1">Editar categoría</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><partial name="_Form" model="Model" /><div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a></div></form></div></div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
