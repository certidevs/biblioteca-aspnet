@model Category
@{
    ViewData["Title"] = "Eliminar categoría";
}

<div class="row justify-content-center"><div class="col-lg-7"><div class="form-panel"><span class="eyebrow text-danger">Administración</span><h1 class="h2 mt-1">Eliminar categoría</h1><p>¿Seguro que quieres eliminar <strong>@Model.Name</strong>?</p><p class="small text-secondary">Los libros no se eliminarán; solo se quitará esta relación de categorización.</p><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="d-flex gap-2"><button class="btn btn-danger" type="submit">Sí, eliminar</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a></div></form></div></div></div>
