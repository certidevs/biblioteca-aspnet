@model List<Category>
@{
    ViewData["Title"] = "Categorías";
    var search = ViewData["Search"] as string;
}

<header class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <span class="eyebrow">Catálogo</span>
        <h1 class="page-title">Categorías</h1>
        <p class="page-subtitle mb-0">Organiza y descubre libros mediante etiquetas y temas.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge-soft">@Model.Count categoría(s)</span>
        @if (User.IsInRole(RoleNames.Admin))
        {
            <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Nueva categoría</a>
        }
    </div>
</header>

<form class="search-panel p-3 p-lg-4 mb-4" method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-9">
            <label class="form-label" for="search">Buscar una categoría</label>
            <div class="input-group">
                <span class="input-group-text" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input class="form-control" id="search" name="search" value="@search" placeholder="Nombre o descripción" />
            </div>
        </div>
        <div class="col-md-3 d-grid">
            <button class="btn btn-primary" type="submit">Buscar categorías</button>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state text-center">
        <div class="empty-icon mx-auto" aria-hidden="true">#</div>
        <h2 class="h4 mt-3">No hay categorías que coincidan</h2>
        <p class="text-secondary">Prueba otra búsqueda o consulta todas las categorías.</p>
        <a class="btn btn-outline-primary" asp-action="Index">Ver todas</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var category in Model)
        {
            var color = ColorContrast.NormalizeHex(category.Color);
            <div class="col-md-6 col-xl-3">
                <article class="detail-panel category-card h-100" style="--category-color:@color">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <span class="badge-soft" style="background-color:@color; color:@ColorContrast.TextColor(category.Color)">@category.Name</span>
                        <span class="category-count">@category.Books.Count</span>
                    </div>
                    <p class="small text-secondary">@(category.Description ?? "Sin descripción disponible.")</p>
                    <div class="d-flex justify-content-between align-items-center gap-2 mt-4">
                        <span class="category-count">libro(s)</span>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@category.Id">Ver categoría <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>
        }
    </div>
}
