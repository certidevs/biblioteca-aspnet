@model ReviewIndexViewModel
@{
    ViewData["Title"] = "Reseñas";
}

<header class="page-header d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <span class="eyebrow">Comunidad</span>
        <h1 class="page-title">Reseñas</h1>
        <p class="page-subtitle mb-0">Opiniones de lectores sobre los libros del catálogo.</p>
    </div>
    <span class="badge-soft">@Model.Reviews.Count reseña(s)</span>
</header>

<form class="search-panel p-3 p-lg-4 mb-4" method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-9">
            <label class="form-label" for="rating">Filtrar por puntuación</label>
            <select asp-for="Rating" class="form-select">
                <option value="">Todas las puntuaciones</option>
                @for (var value = 5; value >= 1; value--)
                {
                    <option value="@value">@value estrellas</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button class="btn btn-primary" type="submit">Filtrar reseñas</button>
        </div>
    </div>
</form>

@if (Model.Reviews.Count == 0)
{
    <div class="empty-state text-center">
        <div class="empty-icon mx-auto" aria-hidden="true"><i class="fa-regular fa-star"></i></div>
        <h2 class="h4 mt-3">No hay reseñas para este filtro</h2>
        <p class="text-secondary mb-0">Prueba con otra puntuación o vuelve a verlas todas.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var review in Model.Reviews)
        {
            <div class="col-md-6">
                <article class="detail-panel h-100">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <span class="eyebrow">Lectura compartida</span>
                            <h2 class="h5 mt-2 mb-0"><a class="link-body-emphasis text-decoration-none" asp-controller="Books" asp-action="Details" asp-route-id="@review.BookId">@review.Book.Title</a></h2>
                        </div>
                        <span class="rating" title="@review.Rating de 5" aria-label="@review.Rating de 5 estrellas">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <i class="@(star <= review.Rating ? "fa-solid" : "fa-regular") fa-star" aria-hidden="true"></i>
                            }
                        </span>
                    </div>
                    <p class="small text-secondary mt-3 mb-2">Por @(review.User.DisplayName ?? review.User.UserName) · @review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                    <p class="mb-0">@review.Comment</p>
                </article>
            </div>
        }
    </div>
}
