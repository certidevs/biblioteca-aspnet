@model ReviewFormViewModel
@{
    ViewData["Title"] = "Editar reseña";
}

<div class="row justify-content-center"><div class="col-lg-7"><div class="form-panel"><span class="eyebrow">Comunidad</span><h1 class="page-title">Editar reseña</h1><p class="page-subtitle">Actualiza tu opinión sobre <strong>@Model.BookTitle</strong>.</p><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><input asp-for="BookId" type="hidden" /><partial name="_Form" model="Model" /><div class="d-flex flex-wrap gap-2 mt-4"><button class="btn btn-primary" type="submit">Guardar cambios</button><a class="btn btn-outline-secondary" asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId">Cancelar</a></div></form></div></div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
