@model Author
@{
    ViewData["Title"] = "Eliminar autor";
}

<div class="row justify-content-center"><div class="col-lg-7"><div class="form-panel">
    <span class="eyebrow text-danger">Administración</span>
    <h1 class="h2 mt-1">Eliminar autor</h1>
    <p>¿Seguro que quieres eliminar a <strong>@Model.Name</strong>?</p>
    <p class="small text-secondary">Sus libros también se eliminarán por la relación en cascada configurada en EF Core.</p>
    <form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="d-flex gap-2"><button class="btn btn-danger" type="submit">Sí, eliminar</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a></div></form>
</div></div></div>
