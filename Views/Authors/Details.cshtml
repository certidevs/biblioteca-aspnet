@model Author
@inject IImageStorage ImageStorage
@{
    ViewData["Title"] = Model.Name;
}

<header class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <a class="small text-decoration-none" asp-action="Index"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>Volver a autores</a>
        <span class="eyebrow d-block mt-4">Autor</span>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle mb-0">@(Model.Nationality ?? "Nacionalidad no indicada") · @(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "Fecha de nacimiento no indicada")</p>
    </div>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Eliminar</a>
        </div>
    }
</header>

<section class="detail-panel profile-summary mb-5">
    <div class="row align-items-start g-4">
        <div class="col-md-3 col-lg-2">
            @if (ImageStorage.GetUrl(ImageFolder.AuthorPhotos, Model.PhotoFileName) is string photoUrl)
            {
                <img class="author-photo author-photo-detail" src="@photoUrl" alt="Fotografía de @Model.Name" />
            }
            else
            {
                <div class="author-photo author-photo-detail author-photo-placeholder" aria-hidden="true">
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                </div>
            }
        </div>
        <div class="col-md-6 col-lg-7">
            <span class="eyebrow">Sobre el autor</span>
            <h2 class="h3 mt-2">Una voz con @Model.Books.Count obra(s) en la biblioteca</h2>
            <p class="text-secondary mb-0">@(Model.Bio ?? "Este autor todavía no tiene biografía.")</p>
        </div>
        <div class="col-md-3 col-lg-3 text-lg-end">
            <span class="stat-label">Libros en catálogo</span>
            <strong class="stat-number">@Model.Books.Count</strong>
        </div>
    </div>
</section>

<section>
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <span class="eyebrow">Bibliografía</span>
            <h2 class="h3 mt-2 mb-0">Libros del autor</h2>
        </div>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Books" asp-action="Index" asp-route-authorId="@Model.Id">Ver en catálogo</a>
    </div>

    @if (Model.Books.Count == 0)
    {
        <div class="empty-state text-center">
            <p class="text-secondary mb-0">Todavía no hay libros de este autor.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var book in Model.Books.OrderBy(book => book.Title))
            {
                <div class="col-md-6 col-xl-4">
                    <article class="book-card h-100">
                        <div class="book-cover">
                            @if (ImageStorage.GetUrl(ImageFolder.BookCovers, book.CoverImageFileName) is string coverUrl)
                            {
                                <img src="@coverUrl" alt="Portada de @book.Title" />
                            }
                            else
                            {
                                <i class="fa-solid fa-book-open" aria-hidden="true"></i>
                            }
                        </div>
                        <div class="p-3 p-lg-4 d-flex flex-column h-100">
                            <span class="small text-uppercase text-secondary fw-bold">Libro</span>
                            <h3 class="h5 mt-1 mb-2"><a class="link-body-emphasis text-decoration-none" asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a></h3>
                            <p class="small text-secondary">@(book.Synopsis ?? "Sin sinopsis disponible.")</p>
                            <div class="d-flex justify-content-between align-items-center gap-2 mt-3">
                                <span class="price-tag">@book.Price.ToString("C")</span>
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">Ver detalle <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>
