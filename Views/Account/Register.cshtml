@model RegisterViewModel
@{
    ViewData["Title"] = "Registro";
}

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="auth-shell row g-0">
            <section class="col-lg-7 auth-panel order-2 order-lg-1">
                <span class="eyebrow">Nueva cuenta</span>
                <h1 class="h2 mt-3">Crea tu espacio lector</h1>
                <p class="text-secondary mb-4">Regístrate para guardar libros, comprar y escribir reseñas.</p>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <form asp-action="Register" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label"></label>
                            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DisplayName" class="form-label"></label>
                            <input asp-for="DisplayName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="DisplayName" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PasswordConfirmation" class="form-label"></label>
                            <input asp-for="PasswordConfirmation" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="PasswordConfirmation" class="text-danger"></span>
                        </div>
                    </div>
                    <button class="btn btn-primary w-100 mt-4" type="submit">Crear cuenta <span aria-hidden="true">→</span></button>
                </form>
                <p class="small text-secondary mt-4 mb-0">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
            </section>
            <aside class="col-lg-5 auth-aside order-1 order-lg-2 d-flex flex-column justify-content-between">
                <div>
                    <span class="eyebrow">Empieza a descubrir</span>
                    <h2 class="display-6 fw-bold mt-3">Tu próxima lectura te espera.</h2>
                    <p class="mt-3 mb-0">Una cuenta sencilla para tener todo tu recorrido lector organizado.</p>
                </div>
                <ul class="small mt-5 mb-0">
                    <li class="mb-2">Marca tus libros favoritos</li>
                    <li class="mb-2">Añade varios libros al carrito</li>
                    <li>Comparte tus opiniones</li>
                </ul>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
