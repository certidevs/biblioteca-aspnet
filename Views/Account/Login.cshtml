@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="auth-shell row g-0">
            <aside class="col-lg-5 auth-aside d-none d-lg-flex flex-column justify-content-between">
                <div>
                    <span class="eyebrow">Biblioteca Digital</span>
                    <h2 class="display-6 fw-bold mt-3">Vuelve a tus historias.</h2>
                    <p class="mt-3 mb-0">Guarda tus libros favoritos, escribe reseñas y consulta tus pedidos desde un mismo lugar.</p>
                </div>
                <ul class="small mt-5 mb-0">
                    <li class="mb-2">Catálogo con filtros y categorías</li>
                    <li class="mb-2">Carrito y pago ficticio</li>
                    <li>Perfil con avatar personalizable</li>
                </ul>
            </aside>
            <section class="col-lg-7 auth-panel">
                <span class="eyebrow">Cuenta</span>
                <h1 class="h2 mt-3">Iniciar sesión</h1>
                <p class="text-secondary mb-4">Accede a tus favoritos, compras y reseñas.</p>

                @if (ViewData["LoggedOut"] is true)
                {
                    <div class="alert alert-success">Has cerrado sesión correctamente.</div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus placeholder="usuario o email" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Entrar <span aria-hidden="true">→</span></button>
                </form>
                <div class="alert alert-light border small mt-4 mb-0">
                    <strong>Demo:</strong> <code>user</code> / <code>User123!</code>
                </div>
                <p class="small text-secondary mt-4 mb-0">¿No tienes cuenta? <a asp-action="Register">Crea una aquí</a></p>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
